# ============================================================
# BOLSAS — VARIABLES DE ENTORNO
# Copiar este archivo a .env.local y llenar los valores
# ============================================================

# ------- Supabase (obligatorio) -------
# Crear el proyecto en https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (para magic links y callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------- Correo (Resend) — opcional en desarrollo -------
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bolsas <no-reply@tu-dominio.com>

# ------- Telegram Bot — opcional -------
# Crear bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ------- WhatsApp (Twilio) — fase 3, opcional -------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
